POSTGRES_USER=identity_server
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identity_server

DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@identity-server-db:5432/$POSTGRES_DB

# Port the app binds to inside its container.
APP_PORT=8080

# Host ports. Only published by docker-compose.dev.yml.
APP_HOST_PORT=8080
DB_HOST_PORT=5432
