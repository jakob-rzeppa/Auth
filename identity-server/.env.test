# Values for the ephemeral end-to-end test stack (docker-compose.e2e.yml).
# Committed on purpose: these are throwaway credentials for a throwaway database.
# Loaded after .env and .env.local so it wins over a developer's local secrets.
POSTGRES_USER=identity_server_test
POSTGRES_PASSWORD=identity_server_test
POSTGRES_DB=identity_server_test

# Written out literally rather than interpolated: this file is layered on top of
# .env, and env_file interpolation resolves against the project environment, not
# the accumulated container environment.
DATABASE_URL=postgres://identity_server_test:identity_server_test@identity-server-db:5432/identity_server_test

APP_PORT=8080

# Where the e2e suite points itself. The test stack publishes no host ports,
# so this is only resolvable from inside the compose network.
BASE_URL=http://identity-server:8080
