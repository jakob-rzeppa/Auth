REDIS_URL=redis://auth-server-redis:6379

POSTGRES_USER=auth_server
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth_server

DATABASE_URL=postgres://auth_server:change-me@auth-server-db:5432/auth_server
# Only used for dev mode
LOCAL_POSTGRES_URL=postgres://auth_server:change-me@127.0.0.1:5433/auth_server

# Port the app binds to inside its container.
APP_PORT=8080

ACCESS_TOKEN_TTL=3600

# Host ports. Only published by docker-compose.dev.yml.
REDIS_HOST_PORT=6379
# 5433, so it does not clash with identity-server's database in the root compose.
DB_HOST_PORT=5433
# 8081, so it does not clash with identity-server's 8080 in the root compose.
APP_HOST_PORT=8081
